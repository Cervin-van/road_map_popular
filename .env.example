# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
FRONTEND_URL=http://localhost:3000
USE_X_FORWARDED_FOR=False

# PostgreSQL (the db service reads POSTGRES_*; Django reads DATABASE_URL)
POSTGRES_DB=road_map
POSTGRES_USER=road_map
POSTGRES_PASSWORD=road_map
DATABASE_URL=postgres://road_map:road_map@db:5432/road_map

# Redis: db 0 = cache, db 1 = Celery broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Email (Mailpit in dev)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@road-map.local

# Popularity formula coefficients
POPULARITY_PRIOR_MEAN=3.0
POPULARITY_PRIOR_WEIGHT=5
POPULARITY_WEIGHT_RATING=50
POPULARITY_WEIGHT_REVIEWS=20
POPULARITY_WEIGHT_VIEWS=10
POPULARITY_VIEWS_WINDOW_DAYS=7

# View deduplication window (seconds)
LOCATION_VIEW_DEDUP_SECONDS=3600

# Location list/map cache TTL (seconds)
LOCATIONS_LIST_CACHE_TTL=300
